# Ignore bundler config
/.bundle

# Ignore all environment files except examples
/.env*
!/.env.example
!/.env.test

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-*
/db/*.db
/db/*.db_*

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp/*
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

# Ignore asset cache and generated assets
/public/assets
/tmp/cache

# Ignore node modules and package manager files (if any)
/node_modules

# Ignore system/editor files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Ignore master key for decrypting credentials and more.
/config/master.key

# Ignore coverage reports
/coverage/
