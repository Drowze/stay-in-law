<div class="container">

  <div style="padding:.75rem 0 .25rem;">
    <a href="/" style="font-size:.85rem; color:var(--muted);">← início</a>
    <h1 style="margin-top:.5rem;">🃏 Carta Outlaw</h1>
  </div>

  <% if @success %>
  <div class="alert alert-success">✅ Carta outlaw emitida com sucesso!</div>
  <% end %>

  <% if @pending_debt > 0 %>
  <div class="alert alert-warn">
    ⚠️ Dívida atual: <strong><%= @pending_debt %> QR code<%= @pending_debt > 1 ? 's' : '' %></strong> a pagar.
  </div>
  <% end %>

  <div class="card">
    <h2>Emitir nova carta</h2>
    <form action="/admin/outlaw" method="post" autocomplete="off">
      <div class="field">
        <label for="description">Motivo (opcional)</label>
        <textarea id="description" name="description" rows="3"
                  placeholder="Ex: ficou 2h a mais sem fazer o dever de casa…"></textarea>
      </div>
      <div class="field">
        <label for="secure_token">Token de segurança</label>
        <input type="password" id="secure_token" name="secure_token" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">⚖️ Emitir Carta Outlaw</button>
    </form>
  </div>

  <% unless @recent_cards.empty? %>
  <div class="card">
    <h2>📜 Cartas recentes</h2>
    <ul style="list-style:none; font-size:.85rem;">
      <% @recent_cards.each do |card| %>
      <li style="padding:.5rem 0; border-bottom:1px solid var(--border);">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <span style="color:var(--muted); font-size:.8rem;"><%= format_brt(card[:created_at]) %></span>
          <% if card[:redeemed_scan_id] %>
            <span style="color:var(--muted); font-size:.8rem;">✅ quitada</span>
          <% else %>
            <span style="color:var(--warn); font-weight:700; font-size:.8rem;">⏳ pendente</span>
          <% end %>
        </div>
        <% if card[:description] %>
        <div style="margin-top:.25rem; color:var(--text); font-style:italic;">
          "<%= h(card[:description]) %>"
        </div>
        <% end %>
      </li>
      <% end %>
    </ul>
  </div>
  <% end %>

</div>
