<div class="container">

  <div class="page-header">
    <a href="/" class="back-link">← início</a>
    <h1>🃏 Carta Outlaw</h1>
  </div>

  <% if @success %>
  <div class="alert alert-success">✅ Carta outlaw emitida com sucesso!</div>
  <% end %>

  <% if @pending_debt > 0 %>
  <div class="alert alert-warn">
    ⚠️ Dívida atual: <strong><%= @pending_debt %> QR code<%= @pending_debt > 1 ? 's' : '' %></strong> a pagar.
  </div>
  <% end %>

  <div class="card">
    <h2>Emitir nova carta</h2>
    <form action="/admin/outlaw" method="post" autocomplete="off">
      <div class="field">
        <label for="description">Motivo (opcional)</label>
        <textarea id="description" name="description" rows="3"
                  placeholder="Ex: ficou 2h a mais sem fazer o dever de casa…"></textarea>
      </div>
      <div class="field">
        <label for="secure_token">Token de segurança</label>
        <input type="password" id="secure_token" name="secure_token" required>
      </div>
      <button type="submit" class="btn btn-primary btn-block">⚖️ Emitir Carta Outlaw</button>
    </form>
  </div>

  <% unless @recent_cards.empty? %>
  <div class="card">
    <h2>📜 Cartas recentes</h2>
    <ul class="outlaw-list">
      <% @recent_cards.each do |card| %>
      <li class="outlaw-list-item">
        <div class="outlaw-list-item-header">
          <span class="outlaw-date"><%= format_brt(card[:created_at]) %></span>
          <% if card[:redeemed_scan_id] %>
            <span class="outlaw-status outlaw-status-redeemed">✅ quitada</span>
          <% else %>
            <span class="outlaw-status outlaw-status-pending">⏳ pendente</span>
          <% end %>
        </div>
        <% if card[:description] %>
        <div class="outlaw-description">"<%= h(card[:description]) %>"</div>
        <% end %>
      </li>
      <% end %>
    </ul>
  </div>
  <% end %>

</div>
