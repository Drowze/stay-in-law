<div class="container">

  <div class="page-header">
    <a href="/" class="back-link">← início</a>
    <h1>🔑 Gerar QR Codes</h1>
  </div>

  <div class="card">
    <form id="generate-form" autocomplete="off">
      <div class="field">
        <label for="count">Quantidade (1–50)</label>
        <input type="number" id="count" name="count" min="1" max="50" value="1" required>
      </div>
      <div class="field">
        <label for="minutes">Minutos por código (1–60)</label>
        <input type="number" id="minutes" name="minutes" min="1" max="60" value="30" required>
      </div>
      <div class="field">
        <label for="secure_token">Token de segurança</label>
        <input type="password" id="secure_token" name="secure_token" required>
      </div>
      <div id="error-msg" class="alert alert-danger is-hidden"></div>
      <button type="submit" class="btn btn-primary btn-block" id="submit-btn">
        Gerar QR Codes
      </button>
    </form>
  </div>

  <div id="qr-results" class="is-hidden">
    <div class="qr-results-header">
      <h2 class="qr-results-heading">✅ QR Codes Gerados</h2>
      <button id="print-btn" class="btn btn-primary qr-print-btn" onclick="printQRCodes()">
        🖨️ Imprimir
      </button>
    </div>
    <div id="qr-grid"></div>
  </div>

</div>

<script src="https://unpkg.com/qr-code-styling@1.6.0/lib/qr-code-styling.js"></script>
<script>
  // Builds a base64 SVG with the minutes number for the QR code center image
  function minutesSVG(minutes) {
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="100" height="68">' +
      '<text x="50" y="50" text-anchor="middle" font-family="Nunito,sans-serif" ' +
      'font-weight="900" font-size="54" fill="#ec4899">' + minutes + '</text>' +
      '</svg>';
    return 'data:image/svg+xml;base64,' + btoa(svg);
  }

  function makeQRCode(element, url, minutes, size) {
    new QRCodeStyling({
      width:  size,
      height: size,
      type:   'canvas',
      data:   url,
      image:  minutesSVG(minutes),
      dotsOptions:          { type: 'rounded',       color: '#6d28d9' },
      cornersSquareOptions: { type: 'extra-rounded',  color: '#ec4899' },
      cornersDotOptions:    { type: 'dot',            color: '#ec4899' },
      backgroundOptions:    { color: '#ffffff' },
      imageOptions:         { crossOrigin: 'anonymous', margin: 0, imageSize: 0.42 }
    }).append(element);
  }

  document.getElementById('generate-form').addEventListener('submit', async function (e) {
    e.preventDefault();

    var btn    = document.getElementById('submit-btn');
    var errDiv = document.getElementById('error-msg');
    var body   = new URLSearchParams(new FormData(e.target));

    btn.textContent = 'Gerando…';
    btn.disabled    = true;
    errDiv.classList.add('is-hidden');

    try {
      var res = await fetch('/admin/qr-codes', {
        method:      'POST',
        credentials: 'same-origin',
        headers:     { 'Content-Type': 'application/x-www-form-urlencoded' },
        body:        body.toString()
      });

      if (res.status === 401) { window.location.reload(); return; }

      var json = await res.json();

      if (!res.ok) {
        errDiv.textContent = json.error || 'Erro desconhecido.';
        errDiv.classList.remove('is-hidden');
        return;
      }

      renderQRCodes(json);
    } catch (err) {
      errDiv.textContent = 'Erro de rede. Tente novamente.';
      errDiv.classList.remove('is-hidden');
    } finally {
      btn.textContent = 'Gerar QR Codes';
      btn.disabled    = false;
    }
  });

  function renderQRCodes(tokens) {
    var grid      = document.getElementById('qr-grid');
    var container = document.getElementById('qr-results');

    grid.innerHTML = '';

    tokens.forEach(function (t) {
      var wrapper = document.createElement('div');
      wrapper.className = 'card qr-card';
      wrapper.dataset.minutes = t.minutes;

      var qrDiv = document.createElement('div');
      qrDiv.className = 'qr-image';

      var info = document.createElement('p');
      info.className = 'qr-info';
      info.innerHTML = '<strong class="qr-info-minutes">' + t.minutes + ' min</strong><br>' + t.scan_url;

      wrapper.appendChild(qrDiv);
      wrapper.appendChild(info);
      grid.appendChild(wrapper);

      makeQRCode(qrDiv, t.scan_url, t.minutes, 220);
    });

    container.classList.remove('is-hidden');
    container.scrollIntoView({ behavior: 'smooth' });
  }

  // Collects rendered QR canvases and opens a print-ready window (4×5 per page)
  function printQRCodes() {
    var cards = document.querySelectorAll('#qr-grid .qr-card');
    if (!cards.length) return;

    var items = Array.from(cards).map(function (card) {
      var canvas  = card.querySelector('canvas');
      var minutes = card.dataset.minutes;
      return { src: canvas ? canvas.toDataURL('image/png') : '', minutes: minutes };
    });

    var cardCSS = [
      'body{margin:0;font-family:Nunito,sans-serif;background:#fff}',
      '.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:8px}',
      '.card{text-align:center;border:1px solid #f3e0ec;border-radius:12px;padding:8px;break-inside:avoid}',
      '.card:nth-child(20n){break-after:always}',
      'img{width:160px;height:160px;display:block;margin:0 auto}',
      '.label{font-size:13px;font-weight:700;color:#6d28d9;margin-top:4px}',
      '@page{size:A4;margin:10mm}'
    ].join('');

    var cardsHTML = items.map(function (item) {
      return '<div class="card"><img src="' + item.src + '"><p class="label">' + item.minutes + ' min</p></div>';
    }).join('');

    var html = '<!DOCTYPE html><html><head><meta charset="UTF-8">' +
      '<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@700&display=swap" rel="stylesheet">' +
      '<style>' + cardCSS + '</style></head><body>' +
      '<div class="grid">' + cardsHTML + '</div>' +
      '<script>window.onload=function(){window.print();window.close();}<\/script>' +
      '</body></html>';

    var win = window.open('', '_blank');
    win.document.write(html);
    win.document.close();
  }
</script>
