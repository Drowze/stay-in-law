<div class="container">

  <div class="page-header">
    <a href="/" class="back-link">← início</a>
    <h1>🔑 Gerar QR Codes</h1>
  </div>

  <div class="card">
    <form id="generate-form" autocomplete="off">
      <div class="field">
        <label for="count">Quantidade (1–50)</label>
        <input type="number" id="count" name="count" min="1" max="50" value="1" required>
      </div>
      <div class="field">
        <label for="minutes">Minutos por código (1–60)</label>
        <input type="number" id="minutes" name="minutes" min="1" max="60" value="30" required>
      </div>
      <div class="field">
        <label for="secure_token">Token de segurança</label>
        <input type="password" id="secure_token" name="secure_token" required>
      </div>
      <div id="error-msg" class="alert alert-danger is-hidden"></div>
      <button type="submit" class="btn btn-primary btn-block" id="submit-btn">
        Gerar QR Codes
      </button>
    </form>
  </div>

  <div id="qr-results" class="is-hidden">
    <h2 class="qr-results-heading">✅ QR Codes Gerados</h2>
    <div id="qr-grid"></div>
    <p class="qr-hint">Dica: use a impressão do navegador para imprimir os QR codes.</p>
  </div>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"
        integrity="sha512-CNgIRecGo7nphbeZ04Sc13ka07paqdeTu0WR1IM4kNcpmBAUSHSQX0FslNhTDadL4O5SAGapGt4FodqL8My0mA=="
        crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script>
  document.getElementById('generate-form').addEventListener('submit', async function (e) {
    e.preventDefault();

    var btn    = document.getElementById('submit-btn');
    var errDiv = document.getElementById('error-msg');
    var body   = new URLSearchParams(new FormData(e.target));

    btn.textContent = 'Gerando…';
    btn.disabled    = true;
    errDiv.classList.add('is-hidden');

    try {
      var res = await fetch('/admin/qr-codes', {
        method:      'POST',
        credentials: 'same-origin',
        headers:     { 'Content-Type': 'application/x-www-form-urlencoded' },
        body:        body.toString()
      });

      // Handle auth challenge: reload to trigger browser's Basic Auth dialog
      if (res.status === 401) { window.location.reload(); return; }

      var json = await res.json();

      if (!res.ok) {
        errDiv.textContent = json.error || 'Erro desconhecido.';
        errDiv.classList.remove('is-hidden');
        return;
      }

      renderQRCodes(json);
    } catch (err) {
      errDiv.textContent = 'Erro de rede. Tente novamente.';
      errDiv.classList.remove('is-hidden');
    } finally {
      btn.textContent = 'Gerar QR Codes';
      btn.disabled    = false;
    }
  });

  function renderQRCodes(tokens) {
    var grid      = document.getElementById('qr-grid');
    var container = document.getElementById('qr-results');

    grid.innerHTML = '';

    tokens.forEach(function (t) {
      var wrapper = document.createElement('div');
      wrapper.className = 'card qr-card';

      var qrDiv = document.createElement('div');
      qrDiv.className = 'qr-image';

      var info = document.createElement('p');
      info.className = 'qr-info';
      info.innerHTML = '<strong class="qr-info-minutes">' + t.minutes + ' min</strong><br>' + t.scan_url;

      wrapper.appendChild(qrDiv);
      wrapper.appendChild(info);
      grid.appendChild(wrapper);

      new QRCode(qrDiv, { text: t.scan_url, width: 200, height: 200 });
    });

    container.classList.remove('is-hidden');
    container.scrollIntoView({ behavior: 'smooth' });
  }
</script>
