<div class="container">

  <!-- Header -->
  <div class="site-header">
    <h1>🌸 Stay in Law</h1>
  </div>

  <!-- Debt warning -->
  <% if @pending_debt > 0 %>
  <div class="alert alert-warn">
    ⚠️ Você deve <strong><%= @pending_debt %> QR code<%= @pending_debt > 1 ? 's' : '' %></strong>.
    O próximo QR code escaneado irá quitar a dívida, não adicionará tempo.
  </div>
  <% end %>

  <!-- Scan notices -->
  <% if @notice == 'success_time_added' %>
  <div class="alert alert-success is-auto-dismiss">
    ✅ QR code escaneado! Tempo adicionado à contagem.
  </div>
  <% elsif @notice == 'success_debt_paid' %>
  <div class="alert alert-success is-auto-dismiss">
    ✅ QR code usado para quitar uma dívida!
  </div>
  <% elsif @notice == 'failure_token_already_used' %>
  <div class="alert alert-warn is-auto-dismiss">
    ⚠️ Este QR code já foi usado esta semana. Tente outro!
  </div>
  <% elsif @notice == 'failure_countdown_active' %>
  <div class="alert alert-warn is-auto-dismiss">
    ⚠️ A contagem regressiva ainda está ativa. Aguarde terminar antes de escanear um novo QR code.
  </div>
  <% elsif @notice == 'failure_bad_scan' %>
  <div class="alert alert-danger is-auto-dismiss">
    ❌ QR code inválido ou erro ao escanear.
  </div>
  <% end %>

  <!-- Countdown card (most prominent element) -->
  <div class="card card-hero">
    <% if @countdown_active %>
      <p class="countdown-label">Tempo restante</p>
      <div id="countdown"
           class="countdown-display"
           data-end="<%= @countdown_end_at.utc.iso8601 %>">
        --:--:--
      </div>
      <p class="countdown-subtext">
        Termina às
        <strong id="finish-time" class="countdown-finish-time">
          <%= format_brt(@countdown_end_at) %>
        </strong>
      </p>
    <% else %>
      <div class="countdown-display countdown-display-idle">00:00:00</div>
      <p class="countdown-subtext">
        <% if @recent_scans.empty? %>
          Nenhum QR code escaneado ainda 🌸
        <% else %>
          Escaneie um QR code para ganhar tempo! 📱
        <% end %>
      </p>
    <% end %>
  </div>

  <!-- Last 5 scans -->
  <% unless @recent_scans.empty? %>
  <div class="card">
    <h2>📋 Últimos usos</h2>
    <ul class="scan-list">
      <% @recent_scans.each do |scan| %>
      <li class="scan-list-item">
        <span class="scan-timestamp"><%= format_brt(scan[:scanned_at]) %></span>
        <% if scan[:outlaw_card_id] %>
          <span>
            <span class="scan-minutes-debt"><%= scan[:minutes] %> min</span>
            <span class="scan-debt-label">(dívida)</span>
          </span>
        <% else %>
          <span class="scan-minutes"><%= scan[:minutes] %> min</span>
        <% end %>
      </li>
      <% end %>
    </ul>
  </div>
  <% end %>

  <!-- Admin links -->
  <div class="admin-footer">
    <span class="admin-footer-label">
      admin:
      <a href="/admin/qr-codes">gerar QR codes</a>
      ·
      <a href="/admin/outlaw">carta outlaw</a>
    </span>
  </div>

</div>

<script>
  (function () {
    var el = document.getElementById('countdown');
    if (!el) return;

    var endAt   = new Date(el.dataset.end);
    var interval;

    function pad(n) { return String(n).padStart(2, '0'); }

    function tick() {
      var remaining = Math.max(0, Math.floor((endAt - Date.now()) / 1000));

      if (remaining <= 0) {
        el.textContent = '00:00:00';
        clearInterval(interval);
        return;
      }

      var h = Math.floor(remaining / 3600);
      var m = Math.floor((remaining % 3600) / 60);
      var s = remaining % 60;
      el.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
    }

    interval = setInterval(tick, 1000);
    tick();
  })();

  // Auto-dismiss notices marked with .is-auto-dismiss after 4 s
  (function () {
    document.querySelectorAll('.is-auto-dismiss').forEach(function (el) {
      setTimeout(function () {
        el.classList.add('is-fading');
        setTimeout(function () { el.remove(); }, 500);
      }, 4000);
    });
  })();

  // Auto-submit scan when ?token= is present in the URL
  (function () {
    var params = new URLSearchParams(window.location.search);
    var token  = params.get('token');
    if (!token) return;

    fetch('/scans', {
      method:      'POST',
      credentials: 'same-origin',
      headers:     { 'Content-Type': 'application/x-www-form-urlencoded' },
      body:        'token=' + encodeURIComponent(token)
    }).then(function (res) {
      if (res.status === 401) {
        window.location.reload();
        return;
      }
      res.json().then(function (data) {
        if (res.status === 201) {
          var notice = data.outlaw_card ? 'success_debt_paid' : 'success_time_added';
          window.location.href = '/?notice=' + notice;
        } else if (res.status === 422) {
          var notice = data.code === 'token_already_used'
            ? 'failure_token_already_used'
            : 'failure_countdown_active';
          window.location.href = '/?notice=' + notice;
        } else {
          window.location.href = '/?notice=failure_bad_scan';
        }
      });
    }).catch(function () {
      window.location.href = '/?notice=failure_bad_scan';
    });
  })();
</script>
