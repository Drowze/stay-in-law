<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#fdf2f8">
  <title>Stay in Law 🌸</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg:           #fdf2f8;
      --card-bg:      #ffffff;
      --primary:      #ec4899;
      --primary-soft: #fce7f3;
      --accent:       #a855f7;
      --text:         #1e1b2e;
      --muted:        #9b8fa6;
      --border:       #f3e0ec;
      --shadow:       0 2px 16px rgba(236, 72, 153, .10);
      --warn:         #f59e0b;
      --warn-soft:    #fffbeb;
      --danger:       #ef4444;
      --danger-soft:  #fef2f2;
      --success:      #10b981;
      --success-soft: #ecfdf5;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Nunito', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      line-height: 1.5;
    }

    .container {
      width: 100%;
      max-width: 480px;
      margin: 0 auto;
      padding: 1.25rem 1rem 2rem;
    }

    .card {
      background: var(--card-bg);
      border-radius: 1.25rem;
      box-shadow: var(--shadow);
      padding: 1.25rem 1.5rem;
      margin-bottom: .875rem;
    }

    h1 { font-size: 1.5rem; font-weight: 900; color: var(--primary); }
    h2 { font-size: 1rem;   font-weight: 700; margin-bottom: .75rem; color: var(--accent); }

    a { color: var(--primary); text-decoration: none; }
    a:hover { text-decoration: underline; }

    .btn {
      display: inline-block;
      padding: .65rem 1.5rem;
      border-radius: 2rem;
      font-family: inherit;
      font-weight: 700;
      font-size: 1rem;
      border: none;
      cursor: pointer;
      transition: opacity .15s;
    }
    .btn:hover    { opacity: .85; }
    .btn:disabled { opacity: .5; cursor: not-allowed; }
    .btn-primary  { background: var(--primary); color: #fff; }
    .btn-block    { display: block; width: 100%; text-align: center; }

    input[type="text"],
    input[type="number"],
    input[type="password"],
    textarea {
      width: 100%;
      padding: .6rem .9rem;
      border: 1.5px solid var(--border);
      border-radius: .6rem;
      font-family: inherit;
      font-size: 1rem;
      color: var(--text);
      background: #fff;
      transition: border-color .15s;
    }
    input:focus, textarea:focus {
      outline: none;
      border-color: var(--primary);
      box-shadow: 0 0 0 3px var(--primary-soft);
    }

    label {
      display: block;
      font-weight: 600;
      font-size: .875rem;
      margin-bottom: .3rem;
    }
    .field { margin-bottom: 1rem; }

    .alert {
      padding: .75rem 1rem;
      border-radius: .75rem;
      font-weight: 600;
      font-size: .875rem;
      margin-bottom: .875rem;
    }
    .alert-warn    { background: var(--warn-soft);    color: #92400e; border: 1.5px solid #fcd34d; }
    .alert-danger  { background: var(--danger-soft);  color: #991b1b; border: 1.5px solid #fca5a5; }
    .alert-success { background: var(--success-soft); color: #166534; border: 1.5px solid #86efac; }
  </style>
</head>
<body>
  <%= yield %>
</body>
</html>
